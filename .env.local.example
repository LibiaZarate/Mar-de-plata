# Copia a .env.local y rellena. Este archivo NO se commitea.

# ── Modo de operación ──────────────────────────────────────
# Solo cuando estés lista para que Sirena hable con clientas reales
# en WhatsApp. Si no está o = "false", la app opera como SIMULADOR:
# todo escribe en Supabase pero NADA se envía a ManyChat.
MODO_PRODUCCION=

# ── Secretos server-side ───────────────────────────────────

# Supabase service role (solo server, NUNCA cliente)
SUPABASE_SERVICE_ROLE_KEY=

# OpenRouter (Verificador Haiku + Agente Madre Opus)
OPENROUTER_API_KEY=

# ManyChat (envío WhatsApp · viene de la credencial httpHeaderAuth "Salvador Manychat")
# Solo necesario cuando MODO_PRODUCCION=true
MANYCHAT_API_KEY=

# OpenAI Whisper (transcripción de audios .ogg de WhatsApp)
OPENAI_API_KEY=

# ── Meta Marketing API (opcional) ──────────────────────────
# Para cruzar campañas y métricas de anuncios de Meta con la
# facturación del dashboard. Sin esto, los anuncios aparecen
# solo con su anuncio_id sin nombre ni métricas de gasto.
#
# Cómo obtener cada valor: ver /configuracion/meta-ads dentro
# del dashboard, ahí hay instrucciones paso a paso.
META_APP_ID=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_BUSINESS_ID=
